let selected="drum";
const titleEl=document.getElementById("guideTitle"),textEl=document.getElementById("guideText"),statusEl=document.getElementById("guideStatus");
function choose(id){
 if(!exhibits[id])return;
 if("speechSynthesis" in window)window.speechSynthesis.cancel();
 selected=id;titleEl.textContent=exhibits[id].title;textEl.textContent=exhibits[id].text;
 document.querySelectorAll(".exhibit").forEach(x=>x.classList.toggle("active",x.dataset.exhibit===id));
 statusEl.textContent="Đã chọn hiện vật. Nhấn “Nghe thuyết minh” để nghe lời giới thiệu.";
 document.getElementById("thuyet-minh").scrollIntoView({behavior:"smooth",block:"start"});
}
document.querySelectorAll("[data-id]").forEach(el=>el.addEventListener("click",()=>choose(el.dataset.id)));
document.querySelectorAll(".photo img").forEach(img=>img.addEventListener("error",()=>img.parentElement.classList.add("failed")));
