 window.speechSynthesis.cancel();
 const u=new SpeechSynthesisUtterance(exhibits[selected].text);u.lang="vi-VN";u.rate=.91;u.pitch=1;
 u.onstart=()=>statusEl.textContent="Hướng dẫn viên đang thuyết minh…";
 u.onend=()=>statusEl.textContent="Đã kết thúc thuyết minh. Bạn có thể nghe lại hoặc chọn hiện vật khác.";
 u.onerror=()=>statusEl.textContent="Không phát được giọng đọc. Hãy kiểm tra trình duyệt hoặc cài đặt giọng nói của thiết bị.";
 window.speechSynthesis.speak(u);
}
